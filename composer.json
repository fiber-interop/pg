{
    "name": "fiber-interop/pg",
    "description": "Cooperative pg_query() for fiber-interop/api: async\\pg\\query(), query_params(), start() and connect() on any adapter, waiting on the libpq socket.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-pgsql": "*",
        "fiber-interop/api": "^0.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11",
        "fiber-interop/revolt": "*",
        "fiber-interop/amp": "*",
        "fiber-interop/react": "*",
        "fiber-interop/phasync": "*",
        "fiber-interop/swoole": "*"
    },
    "autoload": {
        "psr-4": {
            "async\\pg\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "async\\pg\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../api",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../scope",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../revolt",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../amp",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../react",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../phasync",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../swoole",
            "options": {
                "symlink": true
            }
        }
    ]
}
